# --- Database (injected by Railway in prod) ---
DATABASE_URL=postgresql+psycopg://race:race@localhost:5432/race_watcher

# --- Race day ---
RACE_DATE=2026-06-20
TZ=Australia/Melbourne

# --- Movement detector (used by /admin/refresh-odds and the heuristic) ---
MOVEMENT_THRESHOLD_PCT=10
RACE_WINDOW_OPEN_MIN_BEFORE=120
RACE_WINDOW_CLOSE_MIN_AFTER=15

# --- Sources ---
RACE_CARD_SOURCE=seed                # seed | provider
ODDS_SOURCE=openrouter               # openrouter | claude | betfair | mock
PREDICTION_ENGINE=heuristic          # heuristic
SEED_FILE_PATH=seed/flemington.json

# --- OpenRouter adapter (ODDS_SOURCE=openrouter) ---
# Pick ANY model OpenRouter supports. The model string is passed straight through.
# Examples:
#   anthropic/claude-sonnet-4.5     (current default)
#   anthropic/claude-opus-4.1
#   openai/gpt-4o-mini              (cheap & fast)
#   openai/gpt-4o
#   google/gemini-2.5-flash
#   mistralai/mistral-large
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
# Cheap model used by /admin/refresh-odds (one call per refresh).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Heavier model used by /admin/refresh-tips and /admin/expand-field (one call per race).
# Perplexity Sonar is purpose-built for web research with native citations — finds
# complete fields where generic chat models return fragments.
OPENROUTER_RESEARCH_MODEL=perplexity/sonar-pro
# When true, the adapter appends ":online" to non-Perplexity models, routing via
# OpenRouter's web search plugin (~$0.004/search on top of model cost). Perplexity
# models already search natively and are NOT modified by this flag.
OPENROUTER_WEB_SEARCH=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=race-watcher

# --- Claude direct adapter (ODDS_SOURCE=claude) ---
ANTHROPIC_API_KEY=
CLAUDE_RESEARCH_MODEL=claude-sonnet-4-6

# --- Betfair (only required when ODDS_SOURCE=betfair) ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=                   # path to client cert .pem (non-interactive login)
BETFAIR_CERT_KEY_PATH=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
